# ============================================================================
# NEXCOLETAS — CONFIGURAÇÃO DE AMBIENTE (SUPABASE POSTGRESQL + STORAGE)
# ============================================================================

# Ambiente de Execução
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"
APP_TIMEZONE="America/Sao_Paulo"
APP_LOCALE="pt-BR"
APP_BASE_CITY="Manhuaçu"
APP_BASE_STATE="MG"

# ============================================================================
# SUPABASE — INFRAESTRUTURA OFICIAL (BANCO DE DADOS POSTGRESQL & STORAGE)
# ============================================================================

# Seleção explícita do provedor de banco de dados:
# - "supabase": Exige SUPABASE_DATABASE_URL (Obrigatório em produção; sem fallback silencioso)
# - "local": Utiliza variáveis SQL_* locais (Permitido apenas em NODE_ENV != "production")
DB_PROVIDER="local"

# URL de conexão PostgreSQL do Supabase (Pooler Supavisor / Direct Connection com SSL)
SUPABASE_DATABASE_URL=""

# Credenciais do Projeto Supabase
SUPABASE_URL=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# EXCLUSIVO BACKEND — NUNCA EXPOR NO FRONTEND (NUNCA USAR PREFIXO VITE_)
SUPABASE_SERVICE_ROLE_KEY=""

# ============================================================================
# BANCO POSTGRESQL DE DESENVOLVIMENTO LOCAL (APENAS QUANDO DB_PROVIDER="local" E NODE_ENV!="production")
# ============================================================================
SQL_HOST=""
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Segurança & Multi-Tenant
SESSION_SECRET=""
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="120"

# Google Integrations (Preparação — Não usar chaves fictícias)
# Gemini AI (Assistente NexColetas, triagem e análise operacional)
GEMINI_API_KEY=""

# Google Maps Platform (Maps JS, Places, Geocoding, Routes, Address Validation)
VITE_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_SERVER_API_KEY=""

# Firebase (Autenticação Oficial Mantida & Push Notifications PWA)
VITE_FIREBASE_VAPID_KEY=""
